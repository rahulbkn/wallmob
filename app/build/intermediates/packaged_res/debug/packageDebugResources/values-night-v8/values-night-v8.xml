<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#121212</color>
    <color name="black">#000000</color>
    <color name="card_background">#1E1E1E</color>
    <color name="card_elevation">#2A2A2A</color>
    <color name="colorAccent">#5E5CE6</color>
    <color name="colorControlHighlight">#2C2C2C</color>
    <color name="colorControlNormal">#FFFFFF</color>
    <color name="colorOnPrimary">#FFFFFF</color>
    <color name="colorPrimary">#121212</color>
    <color name="colorPrimaryDark">#000000</color>
    <color name="gray_dark">#E0E0E0</color>
    <color name="gray_light">#2A2A2A</color>
    <color name="gray_medium">#9E9E9E</color>
    <color name="green_success">#4CAF50</color>
    <color name="notification_default">#42A5F5</color>
    <color name="notification_favorites">#EC407A</color>
    <color name="notification_offer">#FFA726</color>
    <color name="notification_wallpaper">#66BB6A</color>
    <color name="onBackground">#FFFFFF</color>
    <color name="onSurface">#FFFFFF</color>
    <color name="onSurfaceVariant">#B3B3B3</color>
    <color name="premium_background">#121212</color>
    <color name="premium_gold">#D4AF37</color>
    <color name="profile_avatar_border">#3A3A3A</color>
    <color name="profile_divider">#303030</color>
    <color name="profile_icon_tint">#D4AF37</color>
    <color name="profile_section_bg">#1E1E1E</color>
    <color name="profile_status_bg">#143D22</color>
    <color name="red_error">#F44336</color>
    <color name="ripple_color">#33FFFFFF</color>
    <color name="search_premium_bg">#2A2A2A</color>
    <color name="surface">#121212</color>
    <color name="surfaceVariant">#2A2A2A</color>
    <color name="text_input_box_stroke">#303030</color>
    <color name="text_input_box_stroke_focused">#2196F3</color>
    <color name="toolbar_background">#121212</color>
    <color name="transparent">#00000000</color>
    <color name="white">#FFFFFF</color>
    <style name="AlertDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@drawable/dialog_background_rounded</item>
        
        
        <item name="android:textColorPrimary">@color/onSurface</item>
        <item name="android:titleTextColor">@color/onSurface</item>
        
        
        <item name="android:textColorSecondary">@color/onSurfaceVariant</item>
        
        
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/NeutralButtonStyle</item>
        
        
        <item name="colorAccent">@color/colorAccent</item>
        
        
        <item name="android:divider">@color/profile_divider</item>
        <item name="android:dividerHeight">1dp</item>
    </style>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">

              
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="elevationOverlayEnabled">false</item>

        
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/onBackground</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>

        <item name="android:textColorPrimary">@color/onBackground</item>
        <item name="android:textColorSecondary">@color/gray_dark</item>

        <item name="colorControlNormal">@color/colorControlNormal</item>
        <item name="colorControlHighlight">@color/colorControlHighlight</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="materialCardViewStyle">@style/Widget.App.MaterialCardView</item>
        <item name="materialButtonStyle">@style/PrimaryButton</item>
        <item name="bottomNavigationStyle">@style/Widget.MaterialComponents.BottomNavigationView</item>
        
        
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
    </style>
    <style name="BottomNavActiveText">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BottomNavInactiveText">
        <item name="android:textStyle">normal</item>
    </style>
    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.BottomSheet</item>
    </style>
    <style name="CustomTabTextAppearance" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

    <item name="boxStrokeColor">@color/text_input_box_stroke</item>
    <item name="hintTextColor">@color/onSurfaceVariant</item>
    <item name="android:textColorHint">@color/onSurfaceVariant</item>

</style>
    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/onSurface</item>
    </style>
    <style name="NeutralButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/onSurface</item>
    </style>
    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/red_error</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
       
    </style>
    <style name="ShapeAppearance.BottomSheet" parent="@style/ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item> 
        
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item> 
        
        <item name="postSplashScreenTheme">@style/AppTheme</item> 
    </style>
    <style name="Toolbar.Title.Small" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/onBackground</item>
    </style>
    <style name="ToolbarPopup.Black" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/onSurface</item>
    </style>
    <style name="Widget.App.MaterialCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>