<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Recent Wallpapers Section -->
        <LinearLayout
            android:id="@+id/recent_section"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="4dp"
                android:paddingEnd="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_history"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/onSurface" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textColor="@color/onSurface"
                        android:letterSpacing="-0.01"
                        android:text="@string/section_recent_title"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tv_clear_recent"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tab_text_selector"
                        android:paddingStart="14dp"
                        android:letterSpacing="0.05"
                        android:paddingEnd="14dp"
                        android:background="@drawable/pill_black"
                        android:paddingBottom="6dp"
                        android:text="@string/clear"
                        android:textStyle="bold"
                        android:paddingTop="6dp" />

                </LinearLayout>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/subtle_on_surface"
                    android:letterSpacing="0.01"
                    android:text="@string/section_recent_desc" />

                <View
                    android:layout_height="2dp"
                    android:layout_width="32dp"
                    android:background="@color/onSurface"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_recent"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- Reels Section -->
        <LinearLayout
            android:id="@+id/reels_section"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="4dp"
                android:paddingEnd="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_reels_outline"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/onSurface" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textColor="@color/onSurface"
                        android:letterSpacing="-0.01"
                        android:text="@string/reels"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tv_see_all_reels"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tab_text_selector"
                        android:paddingStart="14dp"
                        android:letterSpacing="0.05"
                        android:paddingEnd="14dp"
                        android:background="@drawable/pill_black"
                        android:paddingBottom="6dp"
                        android:text="@string/section_see_all"
                        android:textStyle="bold"
                        android:paddingTop="6dp" />

                </LinearLayout>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/subtle_on_surface"
                    android:letterSpacing="0.01"
                    android:text="@string/section_reels_desc" />

                <View
                    android:layout_height="2dp"
                    android:layout_width="32dp"
                    android:background="@color/onSurface"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_reels"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- Trending Now Section -->
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="4dp"
                android:paddingEnd="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_trending"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/onSurface" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textColor="@color/onSurface"
                        android:letterSpacing="-0.01"
                        android:text="@string/section_trending_now"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <ImageView
                        android:id="@+id/tv_shuffle"
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_shuffle"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/onSurface" />

                    <TextView
                        android:id="@+id/tv_see_all_trending"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tab_text_selector"
                        android:paddingStart="14dp"
                        android:letterSpacing="0.05"
                        android:paddingEnd="14dp"
                        android:background="@drawable/pill_black"
                        android:paddingBottom="6dp"
                        android:text="@string/section_see_all"
                        android:textStyle="bold"
                        android:paddingTop="6dp" />

                </LinearLayout>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/subtle_on_surface"
                    android:letterSpacing="0.01"
                    android:text="@string/section_trending_desc" />

                <View
                    android:layout_height="2dp"
                    android:layout_width="32dp"
                    android:background="@color/onSurface"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_best_month"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- Color Palettes Section -->
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="4dp"
                android:paddingEnd="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_color_lens"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/onSurface" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="18sp"
                        android:textColor="@color/onSurface"
                        android:letterSpacing="-0.01"
                        android:text="@string/section_color_palettes"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                </LinearLayout>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/subtle_on_surface"
                    android:letterSpacing="0.01"
                    android:text="@string/section_color_palettes_desc" />

                <View
                    android:layout_height="2dp"
                    android:layout_width="32dp"
                    android:background="@color/onSurface"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_color_tone"
                android:layout_height="80dp"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- Premium Section -->
        <LinearLayout
            android:id="@+id/premium_section"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:background="@drawable/premium_bg_gradient"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:paddingBottom="12dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="4dp"
                android:paddingEnd="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:paddingEnd="12dp"
                        android:background="@drawable/premium_badge_bg"
                        android:textSize="10sp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/premium_gold"
                        android:paddingStart="12dp"
                        android:letterSpacing="0.18"
                        android:text="@string/section_premium_badge"
                        android:textStyle="bold"
                        android:paddingTop="5dp" />

                    <View
                        android:layout_height="1dp"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_unlock_all_premium"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/premium_gold"
                        android:paddingStart="14dp"
                        android:letterSpacing="0.05"
                        android:paddingEnd="14dp"
                        android:background="@drawable/premium_cta_bg"
                        android:paddingBottom="6dp"
                        android:text="@string/section_unlock_all"
                        android:textStyle="bold"
                        android:paddingTop="6dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/premium_section_title"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="5dp"
                    android:textSize="18sp"
                    android:textAllCaps="true" 
                    android:textColor="@color/white"
                    android:letterSpacing="-0.01"
                    android:text="@string/section_premium_collection"
                    android:textStyle="bold" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/onImageTertiary"
                    android:letterSpacing="0.01"
                    android:text="@string/section_premium_desc" />

                <View
                    android:layout_height="1dp"
                    android:layout_width="32dp"
                    android:background="@color/premium_gold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_premium"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- Landscape Section -->
        <LinearLayout
            android:id="@+id/landscape_section"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="4dp"
                android:paddingEnd="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_landscape"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/onSurface" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="18sp"
                        android:textColor="@color/onSurface"
                        android:letterSpacing="-0.01"
                        android:text="@string/section_desktop_landscape"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                </LinearLayout>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/subtle_on_surface"
                    android:letterSpacing="0.01"
                    android:text="@string/section_landscape_desc" />

                <View
                    android:layout_height="2dp"
                    android:layout_width="32dp"
                    android:background="@color/onSurface"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_landscape"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- NASA APOD Section -->
        <LinearLayout
            android:id="@+id/nasa_section"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="4dp"
                android:paddingEnd="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/onSurface" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="18sp"
                        android:textColor="@color/onSurface"
                        android:letterSpacing="-0.01"
                        android:text="@string/nasa_space_of_day"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                </LinearLayout>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/subtle_on_surface"
                    android:letterSpacing="0.01"
                    android:text="@string/nasa_desc" />

                <View
                    android:layout_height="2dp"
                    android:layout_width="32dp"
                    android:background="@color/onSurface"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_nasa"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- Categories Section -->
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:paddingBottom="24dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="4dp"
                android:paddingEnd="12dp"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        android:src="@drawable/ic_category"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/onSurface" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="18sp"
                        android:textColor="@color/onSurface"
                        android:letterSpacing="-0.01"
                        android:text="@string/section_categories"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                </LinearLayout>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/subtle_on_surface"
                    android:letterSpacing="0.01"
                    android:text="@string/section_categories_desc" />

                <View
                    android:layout_height="2dp"
                    android:layout_width="32dp"
                    android:background="@color/onSurface"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_categories"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
