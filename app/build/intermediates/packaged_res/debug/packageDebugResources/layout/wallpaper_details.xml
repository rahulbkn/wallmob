<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:id="@+id/root">

   <com.wall.mob.ZoomableImageView
         android:layout_height="0dp"
         android:layout_width="0dp"
          android:scaleType="centerCrop"
          android:background="@drawable/bg"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          android:id="@+id/wallpaperImage" />

    <ProgressBar
         android:id="@+id/imageProgressBar"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:indeterminateTint="@color/onImage"
         app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintBottom_toBottomOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintEnd_toEndOf="parent" />

    <View
         android:layout_height="120dp"
         android:layout_width="0dp"
         android:visibility="gone"
         android:background="@android:drawable/screen_background_dark_transparent"
         app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintEnd_toEndOf="parent" />

    <!-- BACK BUTTON (TOP LEFT) -->
 <ImageButton
         android:layout_height="48dp"
         android:layout_width="48dp"
         android:scaleType="fitCenter"
         android:background="@drawable/back_button_icon"
         app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         
         android:layout_marginTop="35dp"
         android:layout_marginStart="16dp"
         android:id="@+id/back_button" />

    <!-- FAVORITE BUTTON (TOP RIGHT) -->
    <LinearLayout
         android:id="@+id/fav_item"
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:gravity="center"
         android:padding="0dp"
         android:orientation="horizontal"
         android:elevation="4dp"
         android:layout_marginTop="38dp"
         android:layout_marginEnd="20dp"
         app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
             android:id="@+id/fav_button"
             android:layout_height="48dp"
         android:layout_width="48dp"
             android:src="@drawable/ic_favorite"
             android:scaleType="centerInside"
             android:background="@drawable/black_transparent_circle"
             android:elevation="2dp"
            
             android:tint="@color/onImage" />

    </LinearLayout>

    <!-- 🔥 FIXED: BOTTOM ACTION PANEL CONTAINER BOUND TO THE BOTTOM -->
    <FrameLayout
         android:layout_height="wrap_content"
         android:layout_width="0dp"
         android:background="@color/transparent"
         android:elevation="8dp"
         app:layout_constraintStart_toStartOf="parent"
         android:clipToOutline="true"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintBottom_toBottomOf="parent"
         android:id="@+id/bottom_panel_container">

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:id="@+id/realtime_blur_view">
        </LinearLayout>

        <View
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:background="@color/transparent"
             android:id="@+id/view117" />

        <!-- 🔥 FIXED: Configured proper constraints to prevent top-clamping behavior -->
        <androidx.core.widget.NestedScrollView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:maxHeight="380dp"
             android:fillViewport="true"
             android:layout_gravity="bottom"
             android:scrollbars="none">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:paddingEnd="24dp"
                 android:orientation="vertical"
                 android:paddingBottom="32dp"
                 android:paddingStart="24dp"
                 android:id="@+id/linear63"
                 android:paddingTop="40dp"> <!-- Added top padding to offset status changes -->

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="16dp"
                     android:gravity="center_vertical"
                     android:orientation="horizontal"
                     android:id="@+id/linear69">

                    <!-- TEXT INFO CONTAINER -->
                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:gravity="start"
                         android:orientation="vertical"
                         android:id="@+id/linear64">

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:layout_marginBottom="4dp"
                             android:ellipsize="end"
                             android:textSize="22sp"
                             android:textColor="@color/onImage"
                             android:letterSpacing="0.01"
                             android:maxLines="2"
                             android:id="@+id/wallpaperTitle"
                             android:text="@string/wallpaper_title"
                             android:textStyle="bold" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:layout_marginBottom="2dp"
                             android:ellipsize="end"
                             android:textSize="14sp"
                             android:textColor="@color/onImage"
                             android:maxLines="1"
                             android:id="@+id/wallpaper_author"
                             android:text="@string/author_name" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:ellipsize="end"
                             android:textSize="12sp"
                             android:textColor="@color/onImageTertiary"
                             android:maxLines="1"
                             android:id="@+id/wallpaper_source"
                             android:text="@string/source_unsplash" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:layout_marginTop="2dp"
                             android:ellipsize="end"
                             android:textSize="12sp"
                             android:textColor="@color/onImageTertiary"
                             android:maxLines="1"
                             android:id="@+id/wallpaper_resolution"
                             android:text=""
                             android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

                <!-- SLIDE TO SET ACTION PANEL -->
                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="20dp"
                     android:orientation="vertical"
                     android:id="@+id/slide_container">

                    <RelativeLayout
                         android:layout_height="64dp"
                         android:layout_width="match_parent"
                         android:background="@drawable/slide_bg"
                         android:elevation="2dp"
                         android:id="@+id/slide_to_set_container">

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:layout_centerInParent="true"
                             android:textSize="15sp"
                             android:textColor="@color/onImage"
                             android:letterSpacing="0.02"
                             android:id="@+id/slide_text"
                             android:text="@string/slide_to_set"
                             android:textStyle="bold" />

                        <View
                             android:layout_height="64dp"
                             android:layout_width="64dp"
                             android:background="@drawable/slide_thumb_bg"
                             android:layout_centerVertical="true"
                             android:elevation="4dp"
                             android:id="@+id/slide_thumb" />

                    </RelativeLayout>

                </LinearLayout>

                <!-- ACTIONS BUTTON PANEL (EDIT, SHARE, DOWNLOAD) -->
                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:weightSum="3"
                     android:gravity="center_horizontal|center_vertical"
                     android:orientation="horizontal"
                     android:id="@+id/linear65">

                    <!-- EDIT OPTION -->
                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:gravity="center_horizontal|center_vertical"
                         android:padding="4dp"
                         android:orientation="vertical"
                         android:layout_weight="1"
                         android:id="@+id/linear66">

                        <ImageButton
                             android:layout_height="64dp"
                             android:layout_width="64dp"
                             android:src="@drawable/ic_edit"
                             android:scaleType="centerInside"
                             android:background="@drawable/black_transparent_round"
                             android:elevation="2dp"
                             android:padding="16dp"
                             android:tint="@color/onImage"
                             android:id="@+id/edit_btn" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="13sp"
                             android:textColor="@color/onImage"
                             android:layout_marginTop="8dp"
                             android:id="@+id/textview34"
                             android:text="@string/edit"
                             android:textStyle="bold" />

                    </LinearLayout>

                    <!-- SHARE OPTION -->
                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:gravity="center_horizontal|center_vertical"
                         android:padding="4dp"
                         android:orientation="vertical"
                         android:layout_weight="1"
                         android:id="@+id/linear67">

                        <ImageButton
                             android:layout_height="64dp"
                             android:layout_width="64dp"
                             android:src="@drawable/icon_send_round"
                             android:scaleType="centerInside"
                             android:background="@drawable/black_transparent_round"
                             android:elevation="2dp"
                             android:padding="16dp"
                             android:tint="@color/onImage"
                             android:id="@+id/share_btn" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="13sp"
                             android:textColor="@color/onImage"
                             android:layout_marginTop="8dp"
                             android:id="@+id/textview35"
                             android:text="@string/share"
                             android:textStyle="bold" />

                    </LinearLayout>

                    <!-- DOWNLOAD OPTION -->
                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:gravity="center_horizontal|center_vertical"
                         android:padding="4dp"
                         android:orientation="vertical"
                         android:layout_weight="1"
                         android:id="@+id/linear68">

                        <ImageButton
                             android:layout_height="64dp"
                             android:layout_width="64dp"
                             android:src="@drawable/icon_download_round"
                             android:scaleType="centerInside"
                             android:background="@drawable/black_transparent_round"
                             android:elevation="2dp"
                             android:padding="16dp"
                             android:tint="@color/onImage"
                             android:id="@+id/download_btn" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="13sp"
                             android:textColor="@color/onImage"
                             android:layout_marginTop="8dp"
                             android:id="@+id/textview36"
                             android:text="@string/download"
                             android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>




