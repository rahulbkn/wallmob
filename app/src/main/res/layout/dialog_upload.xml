<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reel_sheet_bg"
    android:orientation="vertical">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/reel_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_a_reel"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/share_short_vertical_video"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/closeUploadButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/reel_close_bg"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:src="@drawable/ic_reel_close"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Video picker card -->
            <LinearLayout
                android:id="@+id/selectVideoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/reel_select_video_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="22dp"
                android:paddingEnd="16dp"
                android:paddingBottom="22dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_upload"
                    android:tint="@color/colorAccent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/select_video_file"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/selectedVideoPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/video_format_hint"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/ReelFieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/title_required_label" />

            <EditText
                android:id="@+id/uploadTitleInput"
                style="@style/ReelEditText"
                android:hint="@string/reel_title_hint"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                style="@style/ReelFieldLabel"
                android:text="@string/description_label" />

            <EditText
                android:id="@+id/uploadDescInput"
                style="@style/ReelEditText"
                android:hint="@string/optional_description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:minLines="2" />

            <TextView
                style="@style/ReelFieldLabel"
                android:text="@string/uploader_required_label" />

            <EditText
                android:id="@+id/uploadUploaderInput"
                style="@style/ReelEditText"
                android:hint="@string/your_name_hint"
                android:inputType="text"
                android:maxLines="1"
                android:text="@string/demo_user" />

            <TextView
                style="@style/ReelFieldLabel"
                android:text="@string/category_label" />

            <Spinner
                android:id="@+id/uploadCategorySpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/reel_input_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                style="@style/ReelFieldLabel"
                android:text="@string/hashtags_label" />

            <EditText
                android:id="@+id/uploadHashtagsInput"
                style="@style/ReelEditText"
                android:hint="@string/hashtags_hint_example"
                android:inputType="text"
                android:maxLines="1" />

            <LinearLayout
                android:id="@+id/uploadProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/uploadProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/colorAccent"
                    android:progressTint="@color/colorAccent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/uploading_video_label"
                    android:textColor="#FF4D8A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/submitUploadButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/reel_primary_button_bg"
                android:gravity="center"
                android:text="@string/upload_reel"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
