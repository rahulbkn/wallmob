<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121216">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upload a Reel"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/closeUploadButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close" />

        </LinearLayout>

        <!-- Video Selection Button -->
        <Button
            android:id="@+id/selectVideoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Video File *"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2A2A30"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/selectedVideoPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No file chosen"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:textAlignment="center" />

        <!-- Title Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TITLE *"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/uploadTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="My cool reel"
            android:textColor="#FFFFFF"
            android:textColorHint="#40FFFFFF"
            android:background="#1AFFFFFF"
            android:padding="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:inputType="text" />

        <!-- Description Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/uploadDescInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Optional description..."
            android:textColor="#FFFFFF"
            android:textColorHint="#40FFFFFF"
            android:background="#1AFFFFFF"
            android:padding="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:inputType="textMultiLine"
            android:maxLines="3" />

        <!-- Uploader Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UPLOADER *"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/uploadUploaderInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="demo-user"
            android:textColor="#FFFFFF"
            android:textColorHint="#40FFFFFF"
            android:background="#1AFFFFFF"
            android:padding="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:inputType="text" />

        <!-- Category Dropdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CATEGORY"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/uploadCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="16dp"
            android:padding="12dp" />

        <!-- Hashtags Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HASHTAGS (comma separated)"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/uploadHashtagsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="fun, viral"
            android:textColor="#FFFFFF"
            android:textColorHint="#40FFFFFF"
            android:background="#1AFFFFFF"
            android:padding="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:inputType="text" />

        <!-- Progress Tracker -->
        <LinearLayout
            android:id="@+id/uploadProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <ProgressBar
                android:id="@+id/uploadProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/uploadProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uploading..."
                android:textColor="#FF005C"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/submitUploadButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Reel"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF005C"
            android:padding="14dp" />

    </LinearLayout>

</ScrollView>
