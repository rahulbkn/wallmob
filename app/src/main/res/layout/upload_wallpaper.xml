<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/surface"
                app:titleTextColor="@color/onSurface"
                app:title="@string/upload_wallpaper"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/onSurface"
                app:navigationContentDescription="@string/back_button"
                app:elevation="0dp" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingTop="12dp">

                <!-- Image picker card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/imagePreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/profile_divider"
                    app:strokeWidth="1dp">
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/previewImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:scaleType="centerInside"
        android:src="@drawable/ic_attach"
        android:padding="24dp"
        app:tint="@color/onSurfaceVariant" />

    <TextView
        android:id="@+id/selectImageHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/tap_to_select_image"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/onSurfaceVariant" />

</FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Title field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/titleInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/wallpaper_title_hint"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:hintTextColor="@color/onSurfaceVariant"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/titleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/onSurface"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Category field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/categoryInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:hint="@string/wallpaper_category_hint"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:hintTextColor="@color/onSurfaceVariant"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/categoryInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/onSurface"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Upload button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uploadButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/upload"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_upload"
                    app:iconGravity="textStart"
                    style="@style/PrimaryButton" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Upload overlay -->
    <FrameLayout
        android:id="@+id/uploadOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/uploadProgressBar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="20dp"
                app:indicatorSize="88dp"
                app:trackThickness="6dp"
                app:trackCornerRadius="6dp"
                app:indicatorColor="@color/colorAccent"
                app:trackColor="@color/onSurfaceVariant"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/uploadProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/onSurface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/uploadStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/uploading_label"
                android:textColor="@color/onSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>