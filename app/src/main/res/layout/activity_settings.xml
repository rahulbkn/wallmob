<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        android:elevation="4dp"
        app:title="@string/settings"
        app:titleTextColor="@color/onSurface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/onSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="@string/appearance"
                android:textColor="@color/onSurface" 
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">
<ImageView
    android:id="@+id/iv_theme_icon"
    android:layout_width="@dimen/icon_size_normal"
    android:layout_height="@dimen/icon_size_normal"
    android:src="@drawable/ic_dark"
    app:tint="@color/onSurface" />
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme"
                        android:textColor="@color/onSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_theme_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/system_default"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/iv_language_icon"
                    android:layout_width="@dimen/icon_size_normal"
                    android:layout_height="@dimen/icon_size_normal"
                    android:src="@drawable/ic_language"
                    app:tint="@color/onSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/language"
                        android:textColor="@color/onSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_language_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/english"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/btn_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/iv_text_size_icon"
                    android:layout_width="@dimen/icon_size_normal"
                    android:layout_height="@dimen/icon_size_normal"
                    android:src="@drawable/ic_description"
                    app:tint="@color/onSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_size"
                        android:textColor="@color/onSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_text_size_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_size_option_normal"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="@string/storage"
                android:textColor="@color/onSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/iv_cache_icon"
                    android:layout_width="@dimen/icon_size_normal"
                    android:layout_height="@dimen/icon_size_normal"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/onSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_cache"
                        android:textColor="@color/onSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_cache_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calculating"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Auto Wallpaper Changer Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="@string/auto_wallpaper"
                android:textColor="@color/onSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_changer_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">
                <ImageView android:id="@+id/iv_auto_icon" android:layout_width="@dimen/icon_size_normal" android:layout_height="@dimen/icon_size_normal" android:src="@drawable/ic_auto" app:tint="@color/onSurface" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="@string/auto_change" android:textColor="@color/onSurface" android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_changer" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_changer_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">
                <ImageView android:id="@+id/iv_interval_icon" android:layout_width="@dimen/icon_size_normal" android:layout_height="@dimen/icon_size_normal" android:src="@drawable/ic_time" app:tint="@color/onSurface" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/change_interval" android:textColor="@color/onSurface" android:textSize="16sp" />
                    <TextView android:id="@+id/tv_changer_interval" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/every_24_hours" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="@string/about"
                android:textColor="@color/onSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- New Settings Sections -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_notifications"
                android:textColor="@color/onSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">
                <ImageView android:id="@+id/iv_notifications_icon" android:layout_width="@dimen/icon_size_normal" android:layout_height="@dimen/icon_size_normal" android:src="@drawable/ic_notification" app:tint="@color/onSurface" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="@string/enable_notifications" android:textColor="@color/onSurface" android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_notifications" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="@string/support"
                android:textColor="@color/onSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">
                <ImageView android:id="@+id/iv_feedback_icon" android:layout_width="@dimen/icon_size_normal" android:layout_height="@dimen/icon_size_normal" android:src="@drawable/ic_email" app:tint="@color/onSurface" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/feedback" android:textColor="@color/onSurface" android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_rate_us"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">
                <ImageView android:id="@+id/iv_rate_us_icon" android:layout_width="@dimen/icon_size_normal" android:layout_height="@dimen/icon_size_normal" android:src="@drawable/ic_star" app:tint="@color/onSurface" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/rate_us" android:textColor="@color/onSurface" android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_telegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">
                <ImageView android:id="@+id/iv_telegram_icon" android:layout_width="@dimen/icon_size_normal" android:layout_height="@dimen/icon_size_normal" android:src="@drawable/ic_telegram" app:tint="@color/onSurface" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/join_telegram" android:textColor="@color/onSurface" android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="@string/info"
                android:textColor="@color/onSurface"
                android:textSize="14sp"
                android:textStyle="bold" />
                
            <LinearLayout
                android:id="@+id/btn_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="20dp">
                <ImageView android:id="@+id/iv_about_icon" android:layout_width="@dimen/icon_size_normal" android:layout_height="@dimen/icon_size_normal" android:src="@drawable/ic_info" app:tint="@color/onSurface" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/app_version" android:textColor="@color/onSurface" android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>