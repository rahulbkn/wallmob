<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:keepScreenOn="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="zoom"
        app:shutter_background_color="#000000"
        app:use_controller="false" />

    <View
        android:id="@+id/topScrim"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/scrim_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:background="@drawable/scrim_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/playPauseIcon"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:alpha="0.95"
        android:background="@drawable/reel_play_overlay_bg"
        android:padding="22dp"
        android:src="@drawable/ic_reel_pause"
        android:tint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Right action rail -->
    <LinearLayout
        android:id="@+id/actionRail"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/captionPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/likeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/reel_action_bg"
            android:contentDescription="@string/like"
            android:padding="12dp"
            android:src="@drawable/ic_reel_like_outline"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/likeCount"
            style="@style/ReelActionCount"
            android:text="@string/zero" />

        <ImageButton
            android:id="@+id/commentButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/reel_action_bg"
            android:contentDescription="@string/comments"
            android:padding="12dp"
            android:src="@drawable/ic_reel_comment"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/commentCount"
            style="@style/ReelActionCount"
            android:text="@string/zero" />

        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/reel_action_bg"
            android:contentDescription="@string/share"
            android:padding="12dp"
            android:src="@drawable/ic_reel_share"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/shareCount"
            style="@style/ReelActionCount"
            android:text="@string/zero" />

        <ImageButton
            android:id="@+id/qualityButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/reel_action_bg"
            android:contentDescription="@string/quality"
            android:padding="12dp"
            android:src="@drawable/ic_reel_quality"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/qualityText"
            style="@style/ReelActionCount"
            android:text="@string/quality_auto" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/reel_action_bg"
            android:contentDescription="@string/delete"
            android:padding="12dp"
            android:src="@drawable/ic_reel_delete"
            android:tint="@color/colorAccent" />

        <TextView
            android:id="@+id/deleteText"
            style="@style/ReelActionCount"
            android:text="@string/delete_abbr"
            android:textColor="@color/colorAccent" />

    </LinearLayout>

    <!-- Caption / uploader panel -->
    <LinearLayout
        android:id="@+id/captionPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="80dp"
        android:elevation="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/actionRail"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/reel_status_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/uploaderAvatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/reel_avatar_bg"
                android:gravity="center"
                android:text="@"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uploaderHandle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/placeholder_handle"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/reelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/placeholder_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reelDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/reelProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginBottom="56dp"
        android:progressDrawable="@drawable/reel_progress_drawable"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
