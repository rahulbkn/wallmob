<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:elevation="4dp"
        app:title="@string/profile"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/back_button" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        
        android:fillViewport="true"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">



        <LinearLayout
            android:id="@+id/linear25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imageview8"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circle_background"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/uploadPhotoButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/white"
                    android:background="@drawable/ic_circle_accent"
                    android:padding="4dp"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <ProgressBar
                android:id="@+id/uploadProgressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/welcome_exclaim"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/onSurface" />

            <TextView
                android:id="@+id/userInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/user_info_placeholder"
                android:textSize="16sp"
                android:textColor="@color/gray_dark"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear26"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/linear27"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/linear28"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:padding="16dp"
                    android:background="@drawable/card_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageview9"
                        android:layout_width="32dp"
                        android:tint="@color/onSurface"
                        android:layout_height="32dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_dashboard" />

                    <TextView
                        android:id="@+id/textview27"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/onSurface" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsButton"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:padding="16dp"
                    android:background="@drawable/card_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageview10"
                        android:layout_width="32dp"
                        android:tint="@color/onSurface"
                        android:layout_height="32dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        android:id="@+id/textview28"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/onSurface" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:padding="20dp"
                android:background="@drawable/card_background"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textview29"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/app_status"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/onSurface" />

                <TextView
                    android:id="@+id/textview30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/auth_system_working"
                    android:textSize="14sp"
                    android:textColor="@color/green_success" />

                <TextView
                    android:id="@+id/textview31"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/user_session_active"
                    android:textSize="14sp"
                    android:textColor="@color/green_success" />

                <TextView
                    android:id="@+id/textview32"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all_features_available"
                    android:textSize="14sp"
                    android:textColor="@color/green_success" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/logout"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_primary"
            app:backgroundTint="@null"
            style="@style/PrimaryButton" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>

