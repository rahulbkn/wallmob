<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:orientation="vertical"
     tools:context=".NotificationsActivity">

    <LinearLayout
         android:layout_height="?attr/actionBarSize"
         android:layout_width="match_parent"
         android:background="@color/background"
         android:gravity="center_vertical"
         android:elevation="4dp"
         android:orientation="horizontal"
         android:paddingHorizontal="16dp"
         android:id="@+id/linear7">

        <ImageButton
             android:layout_height="48dp"
             android:layout_width="48dp"
             android:src="@drawable/icon_arrow_back_round"
             android:scaleType="center"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:tint="@color/onSurface"
             android:id="@+id/back_button" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="18sp"
             android:textColor="@color/onSurface"
             android:paddingStart="8dp"
             android:layout_weight="1"
             android:id="@+id/textview14"
             android:text="@string/notifications"
             android:textStyle="bold" />

        <Button
             android:layout_height="36dp"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="@color/onSurface"
             style="@style/Widget.AppCompat.Button.Borderless"
             android:id="@+id/clear_all_button"
             android:text="@string/clear_all" />

    </LinearLayout>

    <FrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:id="@+id/frame_layout8">

        <ProgressBar
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:visibility="gone"
             android:layout_gravity="center"
             android:indeterminate="true"
             android:indeterminateTint="@color/onSurface"
             style="?android:progressBarStyle"
             android:id="@+id/progressBar" />

        <androidx.recyclerview.widget.RecyclerView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:scrollbars="vertical"
             android:paddingStart="8dp"
             android:paddingEnd="8dp"
             android:paddingTop="4dp"
             android:paddingBottom="8dp"
             tools:listitem="@layout/item_notification"
             android:clipToPadding="false"
             android:id="@+id/recyclerView" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:layout_gravity="center"
             android:gravity="center"
             android:orientation="vertical"
             android:padding="24dp"
             android:id="@+id/empty_view">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_notification"
                app:tint="@color/onSurface"
                android:contentDescription="@string/no_notifications_yet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/no_notifications_yet"
                android:textSize="16sp"
                android:textColor="@color/onSurface"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/notifications_desc"
                android:textSize="12sp"
                android:textColor="@color/subtle_on_surface"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.2" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>



