<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/black"
     android:id="@+id/root">

    <jp.co.cyberagent.android.gpuimage.GPUImageView
         android:id="@+id/gpuImageView"
         android:layout_width="0dp"
         android:layout_height="0dp"
         app:gpuimage_show_loading="false"
         app:gpuimage_surface_type="texture_view"
         app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
         android:layout_height="48dp"
         android:layout_width="48dp"
         android:scaleType="fitCenter"
         android:background="@drawable/back_button_icon"
         app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:tint="@color/onImage"
         android:layout_marginTop="35dp"
         android:layout_marginStart="16dp"
         android:id="@+id/back_button" />

    <FrameLayout
         android:layout_height="480dp"
         android:layout_width="0dp"
         android:background="@drawable/blur_panel_bg"
         app:layout_constraintStart_toStartOf="parent"
         android:clipToOutline="true"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintBottom_toBottomOf="parent"
         android:id="@+id/bottom_panel_container">

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:id="@+id/realtime_blur_view">
        </LinearLayout>

        <View
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:background="@drawable/bottom_gradient"
             android:id="@+id/gradient_overlay" />

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:paddingEnd="20dp"
             android:orientation="vertical"
             android:paddingBottom="16dp"
             android:paddingStart="20dp"
             android:id="@+id/main_controls_layout"
             android:paddingTop="16dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="16dp"
                 android:orientation="vertical"
                 android:id="@+id/header_section">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_marginBottom="4dp"
                     android:ellipsize="end"
                     android:textSize="18sp"
                     android:textColor="@color/onImage"
                     android:maxLines="1"
                     android:id="@+id/editor_title"
                     android:text="@string/image_effects"
                     android:textStyle="bold" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:ellipsize="end"
                     android:textSize="12sp"
                     android:textColor="@color/onImage"
                     android:maxLines="1"
                     android:id="@+id/editor_subtitle"
                     android:text="@string/image_effects_desc" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="12dp"
                 android:orientation="vertical"
                 android:id="@+id/blur_section">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_marginBottom="8dp"
                     android:textSize="14sp"
                     android:textColor="@color/onImage"
                     android:id="@+id/blur_title"
                     android:text="@string/blur_effect"
                     android:textStyle="bold" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:background="@drawable/black_transparent_round"
                     android:gravity="center_vertical"
                     android:padding="8dp"
                     android:orientation="horizontal"
                     android:id="@+id/blur_controls">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="@color/onImage"
                         android:minWidth="24dp"
                         android:id="@+id/textview50"
                         android:text="0" />

                    <SeekBar
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:max="25"
                         android:layout_marginHorizontal="12dp"
                         android:thumbTint="@color/onImage"
                         android:progressTint="@color/onImage"
                         android:layout_weight="1"
                         android:id="@+id/blurSeekBar" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="@color/onImage"
                         android:minWidth="24dp"
                         android:id="@+id/textview51"
                         android:text="25" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="12dp"
                 android:orientation="vertical"
                 android:id="@+id/adjustments_section">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_marginBottom="8dp"
                     android:textSize="14sp"
                     android:textColor="@color/onImage"
                     android:text="Adjustments"
                     android:textStyle="bold" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:background="@drawable/black_transparent_round"
                     android:gravity="center_vertical"
                     android:padding="8dp"
                     android:layout_marginBottom="6dp"
                     android:orientation="horizontal">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="@color/onImage"
                         android:minWidth="24dp"
                         android:text="Bri" />

                    <SeekBar
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:max="200"
                         android:progress="100"
                         android:layout_marginHorizontal="12dp"
                         android:thumbTint="@color/onImage"
                         android:progressTint="@color/onImage"
                         android:layout_weight="1"
                         android:id="@+id/brightnessSeekBar" />
                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:background="@drawable/black_transparent_round"
                     android:gravity="center_vertical"
                     android:padding="8dp"
                     android:orientation="horizontal">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="@color/onImage"
                         android:minWidth="24dp"
                         android:text="Con" />

                    <SeekBar
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:max="200"
                         android:progress="100"
                         android:layout_marginHorizontal="12dp"
                         android:thumbTint="@color/onImage"
                         android:progressTint="@color/onImage"
                         android:layout_weight="1"
                         android:id="@+id/contrastSeekBar" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/filterRecyclerView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:clipToPadding="false"
    android:overScrollMode="never" />


            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:weightSum="3"
                 android:gravity="center_horizontal|center_vertical"
                 android:orientation="horizontal"
                 android:id="@+id/action_buttons">

                <Button
                     android:layout_height="48dp"
                     android:layout_width="0dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/black_transparent_round"
                     android:textSize="14sp"
                     android:stateListAnimator="@null"
                     android:textColor="@color/onImage"
                     android:layout_weight="1"
                     android:id="@+id/btnReset"
                     android:text="@string/reset" />

                <Button
                     android:layout_height="48dp"
                     android:layout_width="0dp"
                     android:background="@drawable/black_transparent_round"
                     android:textSize="14sp"
                     android:stateListAnimator="@null"
                     android:textColor="@color/onImage"
                     android:layout_marginStart="8dp"
                     android:layout_weight="1"
                     android:id="@+id/btnApply"
                     android:text="@string/save" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
