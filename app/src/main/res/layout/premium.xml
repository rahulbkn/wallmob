<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_bg_gradient"> <!-- Applied Premium Gradient Background -->

    <!-- Premium Header Section -->
    <LinearLayout
        android:id="@+id/premium_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="90dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exclusive"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textColor="@color/premium_gold"
            android:background="@drawable/premium_badge_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium_collection"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/onImage"
            android:letterSpacing="-0.01"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium_desc"
            android:textSize="14sp"
            android:textColor="@color/onImageTertiary"
            android:letterSpacing="0.01" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="@color/premium_gold"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- Grid / List Content positioned below header -->
    <com.wall.mob.NestedScrollableRecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/premium_header"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/premium_header"
        android:visibility="gone">

        <include layout="@layout/shimmer_premium" />
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Main Loading Progress (Gold) -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="false"
        android:indeterminateTint="#C9A84C"
        android:visibility="gone" />

    <!-- Pagination/Load More Progress (Gold) -->
    <ProgressBar
        android:id="@+id/loading_more_progress"
        style="?android:progressBarStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:indeterminate="false"
        android:indeterminateTint="#C9A84C"
        android:visibility="gone" />

    <!-- Styled Error View -->
    <LinearLayout
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"

        android:backgroundTint="#1AFFFFFF"
        android:elevation="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/failed_to_load_collection"
            android:textAlignment="center"
            android:textColor="@color/onImage"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/check_connection"
            android:textAlignment="center"
            android:textColor="@color/onImageTertiary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#C9A84C"
            android:letterSpacing="0.05"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/retry"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>



