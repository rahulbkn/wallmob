<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:title="@string/create_account"
        android:elevation="4dp"
        app:titleTextColor="@color/onSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/onSurface"
        app:elevation="0dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/linear10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:orientation="vertical">

		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/textinputlayout12"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			app:boxStrokeColor="@color/text_input_box_stroke"
			app:hintTextColor="@color/gray_dark"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/fullNameInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:textColor="@color/onSurface"
				android:hint="@string/full_name"
				android:textColorHint="@color/gray_medium"
				android:inputType="textPersonName" />
		</com.google.android.material.textfield.TextInputLayout>
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/textinputlayout13"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			app:boxStrokeColor="@color/text_input_box_stroke"
			app:hintTextColor="@color/gray_dark"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/emailInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:textColor="@color/onSurface"
				android:hint="@string/email"
				android:textColorHint="@color/gray_medium"
				android:inputType="textEmailAddress" />
		</com.google.android.material.textfield.TextInputLayout>
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/textinputlayout14"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			app:boxStrokeColor="@color/text_input_box_stroke"
			app:hintTextColor="@color/gray_dark"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/phoneInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:textColor="@color/onSurface"
				android:hint="@string/phone_number"
				android:textColorHint="@color/gray_medium"
				android:inputType="phone" />
		</com.google.android.material.textfield.TextInputLayout>
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/textinputlayout15"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			app:boxStrokeColor="@color/text_input_box_stroke"
			app:hintTextColor="@color/gray_dark"
			app:passwordToggleEnabled="true"
			app:passwordToggleTint="@color/gray_dark"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/passwordInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:textColor="@color/onSurface"
				android:hint="@string/password"
				android:textColorHint="@color/gray_medium"
				android:inputType="textPassword" />
		</com.google.android.material.textfield.TextInputLayout>
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/textinputlayout16"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="24dp"
			app:boxStrokeColor="@color/text_input_box_stroke"
			app:hintTextColor="@color/gray_dark"
			app:passwordToggleEnabled="true"
			app:passwordToggleTint="@color/gray_dark"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/confirmPasswordInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:textColor="@color/onSurface"
				android:hint="@string/confirm_password"
				android:textColorHint="@color/gray_medium"
				android:inputType="textPassword" />
		</com.google.android.material.textfield.TextInputLayout>
		<CheckBox
			android:id="@+id/termsCheckbox"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="32dp"
			android:text="@string/agree_terms"
			android:textSize="14sp"
			android:textColor="@color/gray_dark"
			android:buttonTint="@color/onSurface" />
	<com.google.android.material.button.MaterialButton
app:backgroundTint="@null"
			android:id="@+id/registerButton"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:layout_marginBottom="24dp"
			android:background="@drawable/button_primary"
			android:text="@string/create_account"
			android:textSize="16sp"
			android:textStyle="bold"
			android:textColor="@color/white"
			android:elevation="2dp" />
		<LinearLayout
			android:id="@+id/linear12"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:layout_gravity="center_horizontal|center_vertical">
			<TextView
				android:id="@+id/textview12"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/already_have_account"
				android:textSize="14sp"
				android:textColor="@color/gray_dark" />
			<TextView
				android:id="@+id/loginText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="4dp"
				android:background="?android:attr/selectableItemBackground"
				android:text="@string/sign_in"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="@color/onSurface" />
	        </LinearLayout>
</LinearLayout>
    </ScrollView>

</LinearLayout>


