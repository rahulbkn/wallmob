<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:id="@+id/swipeRefreshLayout">

    <FrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent">

        <androidx.core.widget.NestedScrollView
             android:id="@+id/main_scroll_view"
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:background="@color/background">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:id="@+id/main_content_container">

                <androidx.cardview.widget.CardView
                     android:layout_height="250dp"
                     android:layout_width="match_parent"
                     android:layout_marginEnd="0dp"
                     app:cardElevation="0dp"
                     android:layout_marginTop="0dp"
                     android:layout_marginStart="0dp"
                     app:cardCornerRadius="0dp">

                    <FrameLayout
                         android:layout_height="match_parent"
                         android:id="@+id/hero_container"
                         android:layout_width="match_parent">

                        <androidx.viewpager2.widget.ViewPager2
                             android:layout_height="match_parent"
                             android:layout_width="match_parent"
                             android:id="@+id/hero_carousel" />
                             
                             <View
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_gravity="top"
                            android:background="@drawable/scrim_top" />

                        <LinearLayout 
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:paddingEnd="20dp"
                             android:orientation="vertical"
                             android:paddingBottom="20dp"
                             android:paddingStart="20dp"
                             android:layout_gravity="bottom"
                             android:paddingTop="20dp">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="10sp"
                                 android:textColor="@color/white"
                                 android:paddingStart="10dp"
                                 android:letterSpacing="0.20"
                                 android:paddingEnd="10dp"
                                 android:background="@drawable/pill_black"
                                 android:paddingBottom="4dp"
                                 android:backgroundTint="#4D000000"
                                 android:text="@string/section_featured"
                                 android:textStyle="bold"
                                 android:paddingTop="4dp" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="match_parent"
                                 android:id="@+id/hero_title"
                                 android:textSize="32sp"
                                 android:textColor="@color/white"
                                 android:maxLines="2"
                                 android:ellipsize="end"
                                 android:layout_marginTop="8dp"
                                 android:lineSpacingMultiplier="1.05"
                                 android:text="@string/section_discover"
                                 android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:paddingEnd="20dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal"
                             android:paddingBottom="24dp"
                             android:id="@+id/hero_dots"
                             android:layout_gravity="bottom|end">

                        </LinearLayout>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginEnd="0dp"
                     android:elevation="2dp"
                     android:orientation="vertical"
                     android:paddingBottom="24dp"
                     android:layout_marginTop="16dp"
                     android:layout_marginStart="0dp"
                     android:paddingTop="20dp">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_marginBottom="16dp"
                         android:paddingEnd="20dp"
                         android:orientation="vertical"
                         android:paddingStart="20dp">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="10dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="10sp"
                                 android:textColor="@color/onSurface"
                                 android:paddingStart="12dp"
                                 android:letterSpacing="0.18"
                                 android:paddingEnd="12dp"
                                 android:background="@drawable/pill_black"
                                 android:paddingBottom="5dp"
                                 android:backgroundTint="#1A000000"
                                 android:text="@string/section_hot"
                                 android:textStyle="bold"
                                 android:paddingTop="5dp" />

                            <View
                                 android:layout_height="1dp"
                                 android:layout_width="0dp"
                                 android:layout_weight="1" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="11sp"
                                 android:textColor="@color/white"
                                 android:paddingStart="14dp"
                                 android:letterSpacing="0.05"
                                 android:paddingEnd="14dp"
                                 android:background="@drawable/pill_black"
                                 android:paddingBottom="6dp"
                                 android:id="@+id/tv_see_all_trending"
                                 android:text="@string/section_see_all"
                                 android:textStyle="bold"
                                 android:paddingTop="6dp" />

                        </LinearLayout>

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="5dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <ImageView
                                 android:layout_height="24dp"
                                 android:layout_width="24dp"
                                 android:src="@drawable/ic_trending"
                                 android:layout_marginEnd="8dp"
                                 app:tint="@color/onSurface" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="match_parent"
                                 android:textSize="26sp"
                                 android:textColor="@color/onSurface"
                                 android:letterSpacing="-0.01"
                                 android:text="@string/section_trending_now"
                                 android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:textSize="13sp"
                             android:textColor="@color/subtle_on_surface"
                             android:letterSpacing="0.01"
                             android:text="@string/section_trending_desc" />

                        <View
                             android:layout_height="2dp"
                             android:layout_width="32dp"
                             android:background="@color/onSurface"
                             android:layout_marginTop="14dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:paddingEnd="12dp"
                         android:clipToPadding="false"
                         android:paddingStart="12dp"
                         android:nestedScrollingEnabled="false"
                         android:id="@+id/recycler_best_month" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginEnd="0dp"
                     android:elevation="2dp"
                     android:orientation="vertical"
                     android:paddingBottom="24dp"
                     android:layout_marginTop="16dp"
                     android:layout_marginStart="0dp"
                     android:paddingTop="20dp">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_marginBottom="16dp"
                         android:paddingEnd="20dp"
                         android:orientation="vertical"
                         android:paddingStart="20dp">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="10dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="10sp"
                                 android:textColor="@color/onSurface"
                                 android:paddingStart="12dp"
                                 android:letterSpacing="0.18"
                                 android:paddingEnd="12dp"
                                 android:background="@drawable/pill_black"
                                 android:paddingBottom="5dp"
                                 android:backgroundTint="#1A000000"
                                 android:text="@string/section_colors"
                                 android:textStyle="bold"
                                 android:paddingTop="5dp" />

                        </LinearLayout>

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="5dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <ImageView
                                 android:layout_height="24dp"
                                 android:layout_width="24dp"
                                 android:src="@drawable/ic_color_lens"
                                 android:layout_marginEnd="8dp"
                                 app:tint="@color/onSurface" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="match_parent"
                                 android:textSize="26sp"
                                 android:textColor="@color/onSurface"
                                 android:letterSpacing="-0.01"
                                 android:text="@string/section_color_palettes"
                                 android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:textSize="13sp"
                             android:textColor="@color/subtle_on_surface"
                             android:letterSpacing="0.01"
                             android:text="@string/section_color_palettes_desc" />

                        <View
                             android:layout_height="2dp"
                             android:layout_width="32dp"
                             android:background="@color/onSurface"
                             android:layout_marginTop="14dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                         android:layout_height="80dp"
                         android:layout_width="match_parent"
                         android:paddingEnd="12dp"
                         android:clipToPadding="false"
                         android:paddingStart="12dp"
                         android:nestedScrollingEnabled="false"
                         android:id="@+id/recycler_color_tone" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:visibility="gone"
                     android:background="@drawable/premium_bg_gradient"
                     android:orientation="vertical"
                     android:paddingBottom="24dp"
                     android:layout_marginTop="16dp"
                     android:id="@+id/premium_section"
                     android:paddingTop="22dp">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_marginBottom="16dp"
                         android:paddingEnd="16dp"
                         android:orientation="vertical"
                         android:paddingStart="16dp">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="10dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:paddingEnd="12dp"
                                 android:background="@drawable/premium_badge_bg"
                                 android:textSize="10sp"
                                 android:paddingBottom="5dp"
                                 android:textColor="@color/premium_gold"
                                 android:paddingStart="12dp"
                                 android:letterSpacing="0.18"
                                 android:text="@string/section_premium_badge"
                                 android:textStyle="bold"
                                 android:paddingTop="5dp" />

                            <View
                                 android:layout_height="1dp"
                                 android:layout_width="0dp"
                                 android:layout_weight="1" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="11sp"
                                 android:textColor="@color/premium_gold"
                                 android:paddingStart="14dp"
                                 android:letterSpacing="0.05"
                                 android:paddingEnd="14dp"
                                 android:background="@drawable/premium_cta_bg"
                                 android:paddingBottom="6dp"
                                 android:id="@+id/tv_unlock_all_premium"
                                 android:text="@string/section_unlock_all"
                                 android:textStyle="bold"
                                 android:paddingTop="6dp" />

                        </LinearLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="5dp"
                             android:textSize="26sp"
                             android:textColor="@color/white"
                             android:letterSpacing="-0.01"
                             android:id="@+id/premium_section_title"
                             android:text="@string/section_premium_collection"
                             android:textStyle="bold" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:textSize="13sp"
                             android:textColor="@color/onImageTertiary"
                             android:letterSpacing="0.01"
                             android:text="@string/section_premium_desc" />

                        <View
                             android:layout_height="1dp"
                             android:layout_width="32dp"
                             android:background="@color/premium_gold"
                             android:layout_marginTop="14dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:paddingEnd="12dp"
                         android:clipToPadding="false"
                         android:paddingStart="12dp"
                         android:nestedScrollingEnabled="false"
                         android:id="@+id/recycler_premium" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:visibility="gone"
                     android:layout_marginEnd="0dp"
                     android:elevation="2dp"
                     android:orientation="vertical"
                     android:paddingBottom="24dp"
                     android:layout_marginTop="16dp"
                     android:layout_marginStart="0dp"
                     android:id="@+id/landscape_section"
                     android:paddingTop="20dp">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_marginBottom="16dp"
                         android:paddingEnd="20dp"
                         android:orientation="vertical"
                         android:paddingStart="20dp">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="10dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="10sp"
                                 android:textColor="@color/onSurface"
                                 android:paddingStart="12dp"
                                 android:letterSpacing="0.18"
                                 android:paddingEnd="12dp"
                                 android:background="@drawable/pill_black"
                                 android:paddingBottom="5dp"
                                 android:backgroundTint="#1A000000"
                                 android:text="@string/section_wide"
                                 android:textStyle="bold"
                                 android:paddingTop="5dp" />

                        </LinearLayout>

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="5dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="match_parent"
                                 android:textSize="26sp"
                                 android:textColor="@color/onSurface"
                                 android:letterSpacing="-0.01"
                                 android:text="@string/section_desktop_landscape"
                                 android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:textSize="13sp"
                             android:textColor="@color/subtle_on_surface"
                             android:letterSpacing="0.01"
                             android:text="@string/section_landscape_desc" />

                        <View
                             android:layout_height="2dp"
                             android:layout_width="32dp"
                             android:background="@color/onSurface"
                             android:layout_marginTop="14dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:paddingEnd="12dp"
                         android:clipToPadding="false"
                         android:paddingStart="12dp"
                         android:nestedScrollingEnabled="false"
                         android:id="@+id/recycler_landscape" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:visibility="gone"
                     android:orientation="vertical"
                     android:id="@+id/nasa_section">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:paddingEnd="16dp"
                         android:gravity="center_vertical"
                         android:orientation="horizontal"
                         android:paddingBottom="8dp"
                         android:paddingStart="16dp"
                         android:paddingTop="20dp">

                        <ImageView
                             android:layout_height="20dp"
                             android:layout_width="20dp"
                             android:src="@drawable/ic_star"
                             android:contentDescription="@null"
                             android:tint="?attr/colorPrimary" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:textSize="16sp"
                             android:textColor="?attr/colorOnBackground"
                             android:layout_marginStart="8dp"
                             android:layout_weight="1"
                             android:text="@string/nasa_space_of_day"
                             android:textStyle="bold" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                         android:layout_height="220dp"
                         android:layout_width="match_parent"
                         android:paddingEnd="12dp"
                         android:clipToPadding="false"
                         android:paddingStart="12dp"
                         android:nestedScrollingEnabled="false"
                         android:id="@+id/recycler_nasa" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="80dp"
                     android:layout_marginEnd="0dp"
                     android:elevation="2dp"
                     android:orientation="vertical"
                     android:paddingBottom="24dp"
                     android:layout_marginTop="16dp"
                     android:layout_marginStart="0dp"
                     android:paddingTop="20dp">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_marginBottom="16dp"
                         android:paddingEnd="20dp"
                         android:orientation="vertical"
                         android:paddingStart="20dp">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="10dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="10sp"
                                 android:textColor="@color/onSurface"
                                 android:paddingStart="12dp"
                                 android:letterSpacing="0.18"
                                 android:paddingEnd="12dp"
                                 android:background="@drawable/pill_black"
                                 android:paddingBottom="5dp"
                                 android:backgroundTint="#1A000000"
                                 android:text="@string/section_browse"
                                 android:textStyle="bold"
                                 android:paddingTop="5dp" />

                        </LinearLayout>

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginBottom="5dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <ImageView
                                 android:layout_height="24dp"
                                 android:layout_width="24dp"
                                 android:src="@drawable/ic_category"
                                 android:layout_marginEnd="8dp"
                                 app:tint="@color/onSurface" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="match_parent"
                                 android:textSize="26sp"
                                 android:textColor="@color/onSurface"
                                 android:letterSpacing="-0.01"
                                 android:text="@string/section_categories"
                                 android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:textSize="13sp"
                             android:textColor="@color/subtle_on_surface"
                             android:letterSpacing="0.01"
                             android:text="@string/section_categories_desc" />

                        <View
                             android:layout_height="2dp"
                             android:layout_width="32dp"
                             android:background="@color/onSurface"
                             android:layout_marginTop="14dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:paddingEnd="12dp"
                         android:clipToPadding="false"
                         android:paddingStart="12dp"
                         android:nestedScrollingEnabled="false"
                         android:id="@+id/recycler_categories" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.facebook.shimmer.ShimmerFrameLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:visibility="gone"
             app:shimmer_auto_start="true"
             android:id="@+id/shimmer_view_container">

            <include
                 layout="@layout/shimmer_home" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:gravity="center"
             android:background="@color/surface"
             android:padding="32dp"
             android:orientation="vertical"
             android:id="@+id/error_view"
             android:layout_gravity="center">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginBottom="12dp"
                 android:gravity="center"
                 android:textSize="16sp"
                 android:textColor="@color/onSurface"
                 android:id="@+id/error_message"
                 android:text="@string/failed_to_load_wallpapers" />

            <Button
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:paddingEnd="32dp"
                 android:textSize="14sp"
                 android:paddingBottom="12dp"
                 android:backgroundTint="@color/colorPrimary"
                 android:textColor="@color/colorOnPrimary"
                 android:paddingStart="32dp"
                 android:id="@+id/retry_button"
                 android:text="@string/retry"
                 android:paddingTop="12dp" />

        </LinearLayout>

    </FrameLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>