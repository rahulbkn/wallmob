<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App theme switched to DayNight Material Components -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">

              <!--   <item name="android:fontFamily">@font/appfont</item>
        <item name="fontFamily">@font/appfont</item>

         Allow system bar background drawing -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Let Night mode control light/dark system icons; values-night overrides if needed -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Material colors (refer to colors.xml) -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/onBackground</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>

        <item name="android:textColorPrimary">@color/onBackground</item>
        <item name="android:textColorSecondary">@color/gray_dark</item>

        <item name="colorControlNormal">@color/colorControlNormal</item>
        <item name="colorControlHighlight">@color/colorControlHighlight</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="materialCardViewStyle">@style/Widget.App.MaterialCardView</item>
        <item name="materialButtonStyle">@style/PrimaryButton</item>
        <item name="bottomNavigationStyle">@style/Widget.MaterialComponents.BottomNavigationView</item>
        
        <!-- Apply dialog theme to all alert dialogs -->
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
    </style>

    <!-- Alert Dialog Theme -->
    <style name="AlertDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <!-- Background -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@drawable/dialog_background_rounded</item>
        
        <!-- Title -->
        <item name="android:textColorPrimary">@color/onSurface</item>
        <item name="android:titleTextColor">@color/onSurface</item>
        
        <!-- Message -->
        <item name="android:textColorSecondary">@color/onSurfaceVariant</item>
        
        <!-- Buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/NeutralButtonStyle</item>
        
        <!-- Color accent for checkboxes/radio buttons -->
        <item name="colorAccent">@color/colorAccent</item>
        
        <!-- Divider -->
        <item name="android:divider">@color/profile_divider</item>
        <item name="android:dividerHeight">1dp</item>
    </style>

    <!-- Positive Button Style (Logout) -->
    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/red_error</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Negative Button Style (Cancel) -->
    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <!-- Neutral Button Style (if needed) -->
    <style name="NeutralButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <style name="ToolbarPopup.Black" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/onSurface</item>
    </style>

    <style name="Toolbar.Title.Small" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/onBackground</item>
    </style>

    <style name="CustomTextInputLayout"
    parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

    <item name="boxStrokeColor">@color/text_input_stroke</item>
    <item name="hintTextColor">@color/gray_dark</item>
    <item name="android:textColorHint">@color/gray_dark</item>

</style>

    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
       
    </style>

    <style name="Widget.App.MaterialCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="BottomNavActiveText">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNavInactiveText">
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ShapeAppearance.BottomSheet" parent="@style/ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.BottomSheet</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    
    <style name="CustomTabTextAppearance" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ReelActionCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <style name="ReelBottomSheetDialog" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ReelBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#141418</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="ReelBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.BottomSheet</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ReelFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#99FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="ReelEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/reel_input_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#55FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item> 
        
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_monochrome</item> 
        
        <item name="postSplashScreenTheme">@style/AppTheme</item> 
    </style>

</resources>